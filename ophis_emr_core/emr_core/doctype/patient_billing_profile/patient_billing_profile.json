   "in_standard_filter": 1,
   "description": "The province whose health plan this is, and so the province that issued the health card. Set from the plan.",
   "read_only": 1,
   "fetch_from": "payer.province"
  },
  {
   "fieldname": "column_break_profile",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nInactive",
   "default": "Active",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "A coverage that has ended is made Inactive, not deleted"
  },
  {
   "fieldname": "is_primary",
   "fieldtype": "Check",
   "label": "Primary",
   "in_list_view": 1,
   "description": "The coverage billed first. Exactly one active profile of a patient is primary; the provincial health plan is made primary when it is added."
  },
  {
   "fieldname": "expiry_date",
   "fieldtype": "Data",
   "label": "Expiry Date",
   "depends_on": "eval:doc.coverage_type && doc.coverage_type!='Out of Pocket'",
   "description": "When the card or coverage expires, as YYYY-MM-DD. Stored encrypted.",
   "mask": 1
  },
  {
   "fieldname": "plan_section",
   "fieldtype": "Section Break",
   "label": "Plan Details",
   "depends_on": "eval:doc.coverage_type!='Out of Pocket'"
  },
  {
   "fieldname": "plan_values",
   "fieldtype": "Table",
   "label": "Plan Details",
   "options": "Patient Billing Profile Value",
   "description": "The details of the coverage as key and value rows. Which keys exist, which are required and their formats are set by the type, and for a provincial health plan by its province. Details that follow the patient, such as the health card, are kept in step and not edited here."
  },
  {
   "fieldname": "verification_section",
   "fieldtype": "Section Break",
   "label": "Verification",
   "depends_on": "eval:doc.coverage_type && doc.coverage_type!='Out of Pocket'"
