  },
  {
   "fieldname": "issuing_province",
   "fieldtype": "Select",
   "label": "Issuing Province",
   "options": "\nAB\nBC\nMB\nNB\nNL\nNS\nNT\nNU\nON\nPE\nQC\nSK\nYT",
